; 软摩擦椎约束，允许不满足摩擦椎，但是会被惩罚 【当前使用软约束】
frictionConeSoftConstraint
{
  frictionCoefficient    0.65        // 摩擦系数 - 增大到0.65以防止平台/楼梯侧滑

  ; relaxed log barrier parameters  // 松弛障碍函数配置
  mu                     0.1        // 惩罚权重，控制不等式约束不满足条件时惩罚的强度
  delta                  5.0        // 平滑阈值，在 h > δ 区域使用对数障碍（-μ ln h），在 h ≤ δ 区域用二次近似替换对数奇异点以保证数值稳定性。
}

; 自碰撞约束
selfCollision
{
  ; Self Collision raw object pairs
  collisionObjectPairs
  {
  }

  ; Self Collision pairs
  collisionLinkPairs
  {
    [0] "FL_calf, FR_calf"
    [1] "RL_calf, RR_calf"
    [2] "FL_calf, RL_calf"
    [3] "FR_calf, RR_calf"
    [4] "FL_foot, FR_foot"
    [5] "RL_foot, RR_foot"
    [6] "FL_foot, RL_foot"
    [7] "FR_foot, RR_foot"
  }

  minimumDistance  0.01

  ; relaxed log barrier parameters
  mu      1e-2
  delta   1e-3
}

; footPlacemennt Constraint
footPlacement
{
  ; relaxed log barrier parameters
  mu                            1e-2    ; 障碍惩罚权重。越大，越不允许足端靠近或穿出目标多边形边界。
  delta                         1e-4    ; 障碍平滑阈值。越小越接近严格对数障碍，越大则边界附近更平滑、更稳但更软。

  footPlacementRelaxtionMax     0.04    ; 足端位置约束的最大松弛量
  footPlacementRelaxtionPower   2       ; 松弛量与边缘距离的关系幂次，越大表示越接近边缘时松弛越大
  swingActivationProgress       0.7     ; 摆动相进度阈值。只有在摆动后段才开始强制向 touchdown polygon 收敛。
}


; Legacy MPC foothold CBF (independent of swing terrain planning).
footPlacementCbf
{
  ; relaxed log barrier parameters
  mu                            1e-2    ; 障碍惩罚权重。越大，越不允许足端靠近或穿出目标多边形边界。
  delta                         1e-4    ; 障碍平滑阈值。越小越接近严格对数障碍，越大则边界附近更平滑、更稳但更软。


  gamma                         5.0     ; 
  relaxationDerivativeDt        1e-3    ; 

}

