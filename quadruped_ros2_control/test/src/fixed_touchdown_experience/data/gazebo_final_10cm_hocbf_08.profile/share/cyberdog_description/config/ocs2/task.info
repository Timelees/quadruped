; 摆动相轨迹配置
swing_trajectory_config
{
  liftOffVelocity               0.10   // 增大离地速度,更主动抬脚上楼梯
  touchDownVelocity            -0.03   // 降低落地速度以减轻触地冲击
  swingHeight                   0.085  // 适中摆高
  swingTimeScale                0.25   // 增大摆动时间,给robot更多时间抬脚
  footRadius                    0.019  // 接触面到足端运动学球心的高度偏移 [m]
  trackingWeight                25.0 // 完整三维摆动参考跟踪的二次代价
  trackingPositionErrorGain     1.5 // 足端速度误差反馈增益 [1/s]。降低以减少摆动冲击和侧翻
  trackingVerticalHardConstraint true
  trackingVerticalErrorGain     20.0
  useTerrainPlanning            true
  terrainGeometryMode           2    // 0: discrete ablation, 1: Bezier, 2: MINVO
  terrainNumCurveSamples        60
  terrainSubdivisionsPerSpan     4    // rounded up to a power of two
  checkSwingReference           false // section 3.3 adaptive hull/prism certificate
  verifySwingOutput             false // false permits uncertified ablation output only
  collisionHullBasis            1    // 0: Bezier, 1: MINVO
  collisionMaxDepth             10
  collisionMaxSegments          4096
  terrainControlPointTrackingWeight 0.8
  terrainPositionTrackingWeight 0.8
  terrainVelocityTrackingWeight 0.35
  terrainAccelerationTrackingWeight 0.2
  terrainJerkSmoothnessWeight    0.08
  terrainGroundClearance         0.035 // C2 piecewise-quintic envelope
  terrainQpMaxWorkingSetRecalculations 200
  terrainElevationLayer          elevation
  terrainVerbose                 true
  terrainMaxCorrection           0.12 // 增大QP修正范围到12cm以应对8cm障碍
  terrainMaxVelocity             2.0  // 增大速度上限
  terrainMaxAcceleration         80.0 // 增大加速度上限

  ; 三维地形安全走廊：固定XY，MINVO整段约束，球心坐标 ----
  ; 非接触认证区间由 corridorContactPhase 给出；起落脚仍用原有接触过渡约束。
  terrainSafetyCorridorEnabled   true
  corridorLateralExtent          0.15 // 每段路径横向扩展 [m]
  corridorLongitudinalExtent     0.04 // 每段路径前后扩展 [m]
  corridorVerticalExtent         0.08 // 单段参考凸包上下扩展；规划集再收缩2cm [m]
  corridorTerrainRiseRate         0.0 // maximum upward terrain change [m/s]
  corridorHeightError            0.0 // physical height budget: set from calibration, no global bound assumed
  corridorMapMargin              0.0  // 地图误差的各向同性障碍膨胀 [m]，需按感知误差标定
  corridorGeometricClearance     0.001 // 膨胀障碍到几何走廊的严格间隙 [m]
  corridorNumericalMargin        0.0000001 // QP额外方向数值预算 [m]
  corridorContactPhase           0.25 // 前后各25%为接触过渡；中间区间保留完整2cm误差球
  ; corridorFootRadius / corridorTrackingMargin 默认沿用 footRadius / terrainTrackingMargin

  ; P0.1: measured-state correction + exact MINVO admission, fixed touchdown.
  swingOnlineReplanEnabled       true
  swingReplanDirectTestOnly       false // bypass state admission ONLY for controlled ablation
  swingReplanNominalTrackingWeight  0.15
  swingReplanPreviousTrackingWeight 1.0
  swingReplanCorrectionDuration   0.12
  swingReplanActivationDelay      0.0
  mrtTransportStartTime          0.0 // controller time to begin test injection
  mrtTransportDelay              0.0 // test-only one in-flight MRT package hold [s]
  swingReplanUpdateInterval       0.06
  swingReplanMinRemainingTime     0.12
  swingReplanMaxPositionDeviation 0.04
  swingReplanMaxVelocityDeviation 0.40
  swingReplanMaxMarginFraction    0.8
  swingReplanMaxVelocity          3.0
  swingReplanMaxAcceleration      80.0
  swingReplanMaxJerk              12000.0
  swingReplanPositionUncertainty  0.001
  swingReplanVelocityUncertainty  0.01
  swingReplanDisturbanceBound     0.5

  ; P0.2–P0.4 execution filter. Disable the tube independently for ablation.
  safetyFilterEnabled            true
  safetyFilterTubeEnabled        false
  safetyFilterHocbfGain1          20.0
  safetyFilterHocbfGain2          20.0
  safetyFilterDisturbanceBound    0.5
  safetyFilterPositionMeasurementError 0.001
  safetyFilterVelocityMeasurementError 0.01
  safetyFilterPositionBound       0.01
  safetyFilterVelocityBound       0.30
  safetyFilterCouplingGain        10.0
  safetyFilterCouplingBound       0.35
  safetyFilterTubeRate            20.0
  safetyFilterMaxCorrection       5.0
  safetyFilterMaxAcceleration     80.0
  safetyFilterHocbfSampleRate     20.0
  safetyFilterTubeSampleRate      10.0
  safetyFilterMaxPeriod           0.006 // 5 ms Gazebo WBC step plus 1 ms budget
  safetyFilterLandingPositionWindow 0.025
  safetyFilterLandingMaxDownSpeed   0.30
  safetyFilterLandingMaxUpSpeed     0.10

}

; DDP settings
ddp
{
  algorithm                       SLQ

  nThreads                        3
  threadPriority                  50

  maxNumIterations                1
  minRelCost                      1e-1
  constraintTolerance             5e-3

  displayInfo                     false
  displayShortSummary             false
  checkNumericalStability         false
  debugPrintRollout               false
  debugCaching                    false

  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  maxNumStepsPerSecond            10000
  timeStep                        0.015
  backwardPassIntegratorType      ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms          true

  useFeedbackPolicy               false

  strategy                        LINE_SEARCH
  lineSearch
  {
    minStepLength                 1e-2
    maxStepLength                 1.0
    hessianCorrectionStrategy     DIAGONAL_SHIFT
    hessianCorrectionMultiple     1e-5
  }
}


