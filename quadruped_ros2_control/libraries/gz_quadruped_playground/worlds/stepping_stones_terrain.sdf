<?xml version='1.0' encoding='ASCII'?>
<sdf version="1.10">
    <world name='stepping_stones_Terrain'>
        <physics name='1ms' type='ignored'>
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1</real_time_factor>
        </physics>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="stepping_stones_Terrain">
        <static>true</static>
        <link name="link">
        <collision name="collision">
            <geometry>
            <heightmap>
                <uri>model://stepping_stones_terrain/materials/textures/stepping_stones.png</uri>
                <size>20.52 20.52 1</size>
                <pos>0 0 0</pos>

            </heightmap>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
            <heightmap>
                <texture>
                    <diffuse>model://stepping_stones_terrain/materials/textures/grass.jpg</diffuse>
                    <normal>model://stepping_stones_terrain/materials/textures/grass_diffusespecular.png</normal>
                    <size>4</size>
                </texture>
                <texture>
                    <diffuse>model://stepping_stones_terrain/materials/textures/dirt_diffusespecular.png</diffuse>
                    <normal>model://stepping_stones_terrain/materials/textures/dirt_normal.png</normal>
                    <size>1</size>
                </texture>

                <texture>
                    <diffuse>model://stepping_stones_terrain/materials/textures/fungus_diffusespecular.png</diffuse>
                    <normal>model://stepping_stones_terrain/materials/textures/flat_normal.png</normal>
                    <size>1</size>
                </texture>
                <blend>
                    <min_height>0.01</min_height>
                    <fade_dist>0.02</fade_dist>
                </blend>
  
                <blend>
                    <min_height>0.02</min_height>
                    <fade_dist>5</fade_dist>
                </blend>
                <uri>model://stepping_stones_terrain/materials/textures/stepping_stones.png</uri>
                <size>20.52 20.52 1</size>
                <pos>0 0 0</pos>

            </heightmap>
            </geometry>
        </visual>
        </link>
        </model>
    </world>
</sdf>
