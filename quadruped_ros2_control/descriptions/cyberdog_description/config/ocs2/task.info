    baseAccel       2        ; 增大基座加速度权重
    contactForce    0.01
}

; 足端触地估计
contactEstimator
{
    ; 高斯分布参数
    phaseSigma        0.01        ; 支撑相位概率估计参数 (sigma越小，步态信号越清晰)
    swingPhaseSigma   0.01        ; 摆动相位概率估计参数
    footHeightMu      0.025       ; 足端触地高度阈值 (m)，正常触地约0.019m，留余量
    footHeightSigma   0.01        ; 足端高度概率sigma (m)，控制高度区分灵敏度
    footForceSigma    10.0        ; 足端力概率sigma (N)，控制力→概率过渡带宽度
    footForceThreshold 10.0       ; 足端力阈值 (N)，力>阈值时概率>0.5，站立约30-80N，摆动约0-5N

    ; 力低通滤波参数
    forceFilterAlpha        0.5   ; 滤波系数，越大响应越快
    swingForceDecay         0.8   ; 摆动相力衰减系数(暂未用)

    ; 卡尔曼滤波噪声参数
    contactProcessNoise        0.998   ; 过程噪声，越大 Kalman 增益越大
    tauMeasureNoise            0.93    ; 力观测噪声
    fheightMeasureNoise        0.841   ; 高度观测噪声

    ; 接触判定与观测器参数
    contactThreshold           0.5     ; 接触概率阈值 (>threshold 判定为接触)
    observerCutoffFreq         200.0   ; 动量观测器截止频率 (Hz)
}


; State Estimation
kalmanFilter
{
    is_enabled_logger           false        ; 是否开启日志
    sim_mode                    false        ; 仿真/实机模式

    ; LinearKalmanFilter parameters
    footRadius                  0.019       ; 足端半径 [m]

    imuProcessNoisePosition     0.0457     
    imuProcessNoiseVelocity     0.045
    footProcessNoisePosition    0.004

    footSensorNoisePosition     0.002
    footSensorNoiseVelocity     0.002
    footHeightSensorNoise       0.003

    highSuspectNumber           100   
}


； ESKF参数
ErrorStateKalmanFilter
{
    is_enabled_logger                 true        // 是否开启日志

    ; ==================== 噪声放大阈值 ====================
    SwingInflate                      50.0        // 摆动相噪声放大倍数，放大观测矩阵摆动相足端位置部分的噪声
    SlipThreshold                     0.15          // 足端滑动阈值 [m/s] - 增大以避免误检
    SlipInflate                       10.0        // 支撑相足端滑动噪声放大倍数（不要太大，否则滑动时完全忽略观测）

    ; ==================== 误差协方差矩阵P初始值sigma ====================
    InitPosSigma                      0.1        // 位置初始sigma [m]
    InitVelSigma                      0.1        // 速度初始sigma [m/s]
    InitRotSigma                      0.1       // 姿态初始sigma [rad]        
    InitFootPosSigma                  0.1       // 足端位置初始sigma [m]                                    
    InitBiasGyroSigma                 0.1       // 陀螺仪偏置初始sigma [rad/s] - 增大让初期快速收敛                             
    InitBiasAccelSigma                0.1       // 加速度计偏置初始sigma [m/s^2]
                                           
    ; ==================== 过程噪声Q (对IMU预测的不信任程度) ====================
    ; 核心原理：值越大 -> 不信任IMU积分，更依赖观测校正
    ;          值越小 -> 信任IMU积分，观测校正作用减弱
    
    ProcessNoiseAcceleration_X          0.02       // 加速度过程噪声 [m/s^2] 
    ProcessNoiseAcceleration_Y          0.02   
    ProcessNoiseAcceleration_Z          0.02 

    ProcessNoiseGyroscope_X             0.02       // 角速度过程噪声 [rad/s] - 降低以信任陀螺积分
    ProcessNoiseGyroscope_Y             0.02                              
    ProcessNoiseGyroscope_Z             0.02     // Z轴更小，增强yaw稳定性

    ProcessNoiseFootPosition            0.05      // 足端位置过程噪声 [m]

    ProcessNoiseBiasAcceleration_X      0.0001      // 加速度计偏置过程噪声 [m/s^3]
    ProcessNoiseBiasAcceleration_Y      0.0001   
    ProcessNoiseBiasAcceleration_Z      0.0001                                   
    
    ProcessNoiseBiasGyroscope_X         0.0001     // 陀螺仪偏置过程噪声 [rad/s^2] 
    ProcessNoiseBiasGyroscope_Y         0.0001   
    ProcessNoiseBiasGyroscope_Z         0.0001                     

    ; ==================== 观测噪声R (对运动学测量的不信任程度) ====================
    ; 核心原理：值越小 -> 信任运动学观测，观测校正作用强
    ;          值越大 -> 不信任运动学观测，更依赖IMU积分
    
    MeasurementNoiseFootVelocity      0.02          // 足端速度观测噪声 [m/s] - 降低以增强速度观测约束  
                                                  // 增大: 不信任速度观测，速度估计更依赖IMU
                                                  // 减小: 信任速度观测，能有效校正速度漂移
    
    MeasurementNoiseFootPosition      0.01       // 足端位置观测噪声 [m]  ——————影响观测噪声矩阵R
                                                  // 增大: 不信任位置观测，位置估计依赖IMU积分，易漂移
                                                  // 减小: 信任位置观测，能有效约束位置，减少漂移
                                                  
    MeasurementNoiseFootHeight        0.003        // 足端高度观测噪声 [m]  
                                                  // 支撑相时足端z坐标应等于footRadius
                                                  // 减小: 更强的高度约束，防止z方向漂移
                                                  // 增大: 允许更大的高度变化
                                                  
    MeasurementNoiseEncoder           0.003       // 关节编码器观测噪声 [rad]  ——————影响观测噪声矩阵R
    
    FootRadius                        0.0207       // 足端半径 [m]，用于高度约束
    
}