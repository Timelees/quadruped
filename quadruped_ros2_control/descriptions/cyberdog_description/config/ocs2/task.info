   (3,0)  0.0     ; L_x / robotMass
   (4,0)  0.0     ; L_y / robotMass
   (5,0)  0.0     ; L_z / robotMass

   ;; Base Pose: [position, orientation] ;;
   (6,0)  0.0     ; p_base_x
   (7,0)  0.0     ; p_base_y
   (8,0)  0.26     ; p_base_z
   (9,0)  0.0     ; theta_base_z
   (10,0) 0.0     ; theta_base_y
   (11,0) 0.0     ; theta_base_x

   ;; Leg Joint Positions: [FL, RL, FR, RR] ;;
   (12,0)  0.10   ; FL_hip_joint
   (13,0)  0.68   ; FL_thigh_joint
   (14,0) -1.44   ; FL_calf_joint
   (15,0)  0.10   ; RL_hip_joint
   (16,0)  0.68   ; RL_thigh_joint
   (17,0) -1.44   ; RL_calf_joint
   (18,0)  -0.10   ; FR_hip_joint
   (19,0)  0.68   ; FR_thigh_joint
   (20,0) -1.44   ; FR_calf_joint
   (21,0)  -0.10   ; RR_hip_joint
   (22,0)  0.68   ; RR_thigh_joint
   (23,0) -1.44   ; RR_calf_joint
}

; standard state weight matrix
Q
{
  scaling 1e+0

  ;; Normalized Centroidal Momentum: [linear, angular] ;;
  (0,0)   15.0     ; vcom_x  -- 增大以更好跟踪速度指令
  (1,1)   15.0     ; vcom_y 
  (2,2)   100.0     ; vcom_z
  (3,3)   10.0      ; L_x / robotMass
  (4,4)   30.0      ; L_y / robotMass
  (5,5)   30.0     ; L_z / robotMass

  ;; Base Pose: [position, orientation] ;;
  (6,6)   1000.0   ; p_base_x -- 增大以减少x漂移
  (7,7)   1000.0   ; p_base_y -- 增大以减少y漂移
  (8,8)   1500.0   ; p_base_z -- 增大以减少z漂移
  (9,9)   100.0    ; theta_base_z   -- 增大以减少姿态的z旋转
  (10,10) 300.0    ; theta_base_y
  (11,11) 300.0    ; theta_base_x

  ;; Leg Joint Positions: [FL, RL, FR, RR] ;; -- 增加以更好跟踪关节位置
  (12,12) 5.0     ; FL_hip_joint
  (13,13) 5.0     ; FL_thigh_joint
  (14,14) 2.5     ; FL_calf_joint
  (15,15) 5.0     ; RL_hip_joint
  (16,16) 5.0     ; RL_thigh_joint
  (17,17) 2.5     ; RL_calf_joint
  (18,18) 5.0     ; FR_hip_joint
  (19,19) 5.0     ; FR_thigh_joint
  (20,20) 2.5     ; FR_calf_joint
  (21,21) 5.0     ; RR_hip_joint
  (22,22) 5.0     ; RR_thigh_joint
  (23,23) 2.5     ; RR_calf_joint
}

; control weight matrix
R
{
  scaling 1e-3

  ;; Feet Contact Forces: [FL, FR, RL, RR] ;; 接触力权重
  (0,0)   1.0       ; front_left_force
  (1,1)   1.0       ; front_left_force
  (2,2)   1.0       ; front_left_force
  (3,3)   1.0       ; front_right_force
  (4,4)   1.0       ; front_right_force
  (5,5)   1.0       ; front_right_force
  (6,6)   1.0       ; rear_left_force
  (7,7)   1.0       ; rear_left_force
  (8,8)   1.0       ; rear_left_force
  (9,9)   1.0       ; rear_right_force
  (10,10) 1.0       ; rear_right_force
  (11,11) 1.0       ; rear_right_force

  ;; foot velocity relative to base: [FL, RL, FR, RR] (uses the Jacobian at nominal configuration) ;; 足端速度权重，平滑的足端运动
  (12,12) 5000.0    ; x
  (13,13) 5000.0    ; y
  (14,14) 5000.0    ; z
  (15,15) 5000.0    ; x
  (16,16) 5000.0    ; y
  (17,17) 5000.0    ; z
  (18,18) 5000.0    ; x
  (19,19) 5000.0    ; y
  (20,20) 5000.0    ; z
  (21,21) 5000.0    ; x
  (22,22) 5000.0    ; y
  (23,23) 5000.0    ; z
}
; 软摩擦椎约束，允许不满足摩擦椎，但是会被惩罚 【当前使用软约束】
frictionConeSoftConstraint
{
  frictionCoefficient    0.3        // 摩擦系数 - 增大以减少足端滑动

  ; relaxed log barrier parameters  // 松弛障碍函数配置
  mu                     0.1        // 惩罚权重，控制不等式约束不满足条件时惩罚的强度
  delta                  5.0        // 平滑阈值，在 h > δ 区域使用对数障碍（-μ ln h），在 h ≤ δ 区域用二次近似替换对数奇异点以保证数值稳定性。
}

; 自碰撞约束
selfCollision
{
  ; Self Collision raw object pairs
  collisionObjectPairs
  {
  }

  ; Self Collision pairs
  collisionLinkPairs
  {
    [0] "FL_knee, FR_knee"      // cyberdog的小腿
    [1] "RL_knee, RR_knee"
    [2] "FL_knee, RL_knee"
    [3] "FR_knee, RR_knee"
    [4] "FL_knee, FR_knee"
    [5] "RL_knee, RR_knee"
    [6] "FL_knee, RL_knee"
    [7] "FR_knee, RR_knee"
  }

  minimumDistance  0.05

  ; relaxed log barrier parameters
  mu      1e-2
  delta   1e-3
}

; Whole body control
torqueLimitsTask
{
   (0,0)  12.0     ; HAA
   (1,0)  12.0     ; HFE
   (2,0)  12.0     ; KFE
}

; 摩擦椎硬约束，必须严格满足摩擦椎约束，否则求解不可达
frictionConeTask
{
  frictionCoefficient    0.3  ; 与frictionConeSoftConstraint保持一致
}

swingLegTask
{
    kp                   400  ; 
    kd                   30   ; 
}

weight
{
    swingLeg        150      ; 增大摆动腿权重以提高轨迹跟踪
    baseAccel       1        ; 增大基座加速度权重
    contactForce    0.01
}

; 足端触地估计
contactEstimator
{
    ; 高斯分布参数
    contactPhaseSigma        0.01        ; 支撑相位概率估计参数
    swingPhaseSigma          0.01        ; 摆动相位概率估计参数
    footHeightMu             0.019       ; 足端触地高度阈值
    footHeightSigma          0.01        ; 足端高度概率sigma
    footForceSigma           10.0        ; 足端力概率sigma
    footForceThreshold       15.0        ; 足端力阈值 (N)，力>阈值时概率>0.5

    ; 卡尔曼滤波噪声参数
    contactProcessNoise        0.998   ; 过程噪声，越大 Kalman 增益越大
    tauMeasureNoise            0.93    ; 力观测噪声
    fheightMeasureNoise        0.841   ; 高度观测噪声
}


; State Estimation
kalmanFilter
{
    is_enabled_logger           false        ; 是否开启日志
    sim_mode                    true        ; 仿真/实机模式

    ; LinearKalmanFilter parameters
    footRadius                  0.02
    imuProcessNoisePosition     0.02
    imuProcessNoiseVelocity     0.02
    footProcessNoisePosition    0.002

    footSensorNoisePosition     0.005
    footSensorNoiseVelocity     0.1
    footHeightSensorNoise       0.01

    highSuspectNumber           10000   
}


； ESKF参数
ErrorStateKalmanFilter
{
    is_enabled_logger                 true        // 是否开启日志

    SwingInflate                      100.0        // 摆动相噪声放大倍数
    
    ; ==================== 过程噪声Q (对IMU预测的不信任程度) ====================
    ; 核心原理：值越大 -> 不信任IMU积分，更依赖观测校正
    ;          值越小 -> 信任IMU积分，观测校正作用减弱
    ProcessNoiseAcceleration          0.15        // 加速度过程噪声 [m/s^2] 
    ProcessNoiseGyroscope             0.003       // 角速度过程噪声 [rad/s] 
    ProcessNoiseFootPosition          0.005      // 足端位置过程噪声 [m] 
    ProcessNoiseBiasAcceleration      0.02     // 加速度计偏置过程噪声 [m/s^3]                         
    ProcessNoiseBiasGyroscope         0.02     // 陀螺仪偏置过程噪声 [rad/s^2]
              
    ; ==================== 观测噪声R (对运动学测量的不信任程度) ====================
    ; 核心原理：值越小 -> 信任运动学观测，观测校正作用强
    ;          值越大 -> 不信任运动学观测，更依赖IMU积分
    
    MeasurementNoiseFootVelocity      0.005          // 足端速度观测噪声 [m/s]               
    MeasurementNoiseFootPosition      0.003       // 足端位置观测噪声 [m]                                 
    MeasurementNoiseFootHeight        0.003       // 足端高度观测噪声 [m] 
                                                  
    MeasurementNoiseEncoder           0.005       // 关节编码器观测噪声 [rad] 

    MeasurementNoiseAttitude          0.005        // IMU姿态软约束噪声 [rad] 
    
    FootRadius                        0.019       // 足端半径
    
}