    imuProcessNoisePosition     0.02     
    imuProcessNoiseVelocity     0.015
    footProcessNoisePosition    0.0005

    footSensorNoisePosition     0.005
    footSensorNoiseVelocity     0.005
    footHeightSensorNoise       0.05

    highSuspectNumber           100   
}


； ESKF参数
ErrorStateKalmanFilter
{
    is_enabled_logger                 true        // 是否开启日志

    ; ==================== 噪声放大阈值 ====================
    SwingInflate                      1000.0       // 摆动相噪声放大倍数，放大观测矩阵摆动相足端位置部分的噪声
    SlipThreshold                     0.05        // 足端滑动阈值
    SlipInflate                       1000.0        // 支撑相足端滑动噪声放大倍数，放大观测矩阵支撑相足端速度部分的噪声

    ; ==================== 误差协方差矩阵P初始值sigma ====================
    ; 影响：控制滤波器初始化时对各状态的信任程度
    ; 增大 -> 初始不确定性大，滤波器会更快调整状态以适应观测，但可能过度响应噪声
    ; 减小 -> 初始不确定性小，滤波器更信任初始值，收敛较慢但更稳定
    InitPosSigma                      0.03        // 位置初始sigma [m]
                                                  // 增大: 位置估计初期波动大，快速收敛但可能overshoot
                                                  // 减小: 位置估计初期稳定，但若初始值偏差大则收敛慢
    
    InitVelSigma                      0.03        // 速度初始sigma [m/s]
                                                  // 增大: 速度估计响应快，但易受噪声影响
                                                  // 减小: 速度估计稳定，但动态响应变慢
    
    InitRotSigma                      0.05       // 姿态初始sigma [rad]
                                                  // 增大: 姿态估计初期调整幅度大
                                                  // 减小: 更信任IMU初始姿态，通常IMU姿态较准
    
    InitFootPosSigma                  0.02        // 足端位置初始sigma [m]
                                                  // 增大: 足端位置不确定性大
                                                  // 减小: 足端估计更稳定
    
    InitBiasGyroSigma                 0.05       // 陀螺仪偏置初始sigma [rad/s]
                                                  // 增大: 偏置估计变化快
                                                  // 减小: 偏置估计保守稳定
    
    InitBiasAccelSigma                0.05        // 加速度计偏置初始sigma [m/s^2]
                                                  // 增大: 偏置估计变化快
                                                  // 减小: 偏置估计保守稳定


    ; ==================== 过程噪声Q (对IMU预测的不信任程度) ====================
    ; 核心原理：值越大 -> 不信任IMU积分，更依赖观测校正
    ;          值越小 -> 信任IMU积分，观测校正作用减弱
    
    ProcessNoiseAcceleration          0.0035        // 加速度过程噪声 [m/s^2]——积分一次变成速度噪声，积分两次变成位置噪声
                                                  // 增大: 不信任IMU加速度积分，速度/位置估计更依赖足端观测
                                                  // 减小: 信任IMU加速度积分，减小对观测的依赖
    
    ProcessNoiseGyroscope             0.002        // 角速度过程噪声 [rad/s]
                                                  // 增大: 不信任角速度积分，姿态更依赖观测
                                                  // 减小: 信任角速度积分，姿态平滑但可能漂移


    ProcessNoiseFootPosition          0.005      // 足端位置过程噪声 [m]
                                                  // 增大: 允许足端位置变化大，适合摆动腿
                                                  // 减小: 假设足端静止，适合接触腿
    
    ProcessNoiseBiasAcceleration      0.0005      // 加速度计偏置过程噪声 [m/s^3]
                                                  // 增大: 偏置估计变化快，可跟踪快速变化的偏置
                                                  // 减小: 偏置估计稳定，假设偏置变化慢
    
    ProcessNoiseBiasGyroscope         0.0005     // 陀螺仪偏置过程噪声 [rad/s^2]
                                                  // 增大: 偏置估计变化快
                                                  // 减小: 偏置估计稳定


    ; ==================== 观测噪声R (对运动学测量的不信任程度) ====================
    ; 核心原理：值越小 -> 信任运动学观测，观测校正作用强
    ;          值越大 -> 不信任运动学观测，更依赖IMU积分
    
    MeasurementNoiseFootVelocity      0.02         // 足端速度观测噪声 [m/s] 
                                                  // 增大: 不信任速度观测，速度估计更依赖IMU
                                                  // 减小: 信任速度观测，能有效校正速度漂移
    
    MeasurementNoiseFootPosition      0.006       // 足端位置观测噪声 [m]  ——————影响观测噪声矩阵R
                                                  // 增大: 不信任位置观测，位置估计依赖IMU积分，易漂移
                                                  // 减小: 信任位置观测，能有效约束位置，减少漂移
                                                  
    MeasurementNoiseFootHeight        0.009        // 足端高度观测噪声 [m]  
                                                  // 支撑相时足端z坐标应等于footRadius
                                                  // 减小: 更强的高度约束，防止z方向漂移
                                                  // 增大: 允许更大的高度变化
                                                  
    MeasurementNoiseEncoder           0.003        // 关节编码器观测噪声 [rad]  ——————影响观测噪声矩阵R
    
    FootRadius                        0.0207       // 足端半径 [m]，用于高度约束
    
}